// Edit member
function editMember(index) {
    selectedMemberIndex = index;
    const m = members[index];
    document.getElementById('editMembershipNo').value = m.membershipNo;
    document.getElementById('editName').value = m.name;
    document.getElementById('editFatherName').value = m.fatherName;
    document.getElementById('editContact').value = m.contact;
    document.getElementById('editIqama').value = m.iqama;
    document.getElementById('editOverseasAddress').value = m.overseasAddress;
    document.getElementById('editPakistanAddress').value = m.pakistanAddress;
    document.getElementById('editModal').classList.remove('hidden');
}

// Save edit
function saveEdit() {
    if (selectedMemberIndex === null) return;
    const m = members[selectedMemberIndex];
    const oldContact = m.contact;
    m.name = document.getElementById('editName').value.trim();
    m.fatherName = document.getElementById('editFatherName').value.trim();
    m.contact = document.getElementById('editContact').value.trim();
    m.iqama = document.getElementById('editIqama').value.trim();
    m.overseasAddress = document.getElementById('editOverseasAddress').value.trim();
    m.pakistanAddress = document.getElementById('editPakistanAddress').value.trim();

    if (oldContact !== m.contact) {
        for (let role in executiveMembers) {
            if (executiveMembers[role]?.contact === oldContact) {
                executiveMembers[role].contact = m.contact;
                executiveMembers[role].name = m.name;
            }
        }
        loans.forEach(loan => {
            if (loan.contact === oldContact && loan.isExistingMember) {
                loan.contact = m.contact;
                loan.name = m.name;
            }
        });
        localStorage.setItem('executiveMembers', JSON.stringify(executiveMembers));
        localStorage.setItem('loans', JSON.stringify(loans));
    }

    localStorage.setItem('members', JSON.stringify(members));
    closeModal();
    renderMembers();
    renderExecutiveMembers();
    renderLoans();
}

// Delete member
function deleteMember(index) {
    if (confirm('Delete this member permanently?')) {
        const member = members[index];
        for (let role in executiveMembers) {
            if (executiveMembers[role]?.contact === member.contact) {
                delete executiveMembers[role];
            }
        }
        loans.forEach(loan => {
            if (loan.contact === member.contact && loan.isExistingMember) {
                loan.isDeleted = true;
            }
        });
        members.splice(index, 1);
        members.forEach((member, i) => {
            member.membershipNo = `GOC-${String(i + 1).padStart(4, '0')}`;
        });
        localStorage.setItem('members', JSON.stringify(members));
        localStorage.setItem('executiveMembers', JSON.stringify(executiveMembers));
        localStorage.setItem('loans', JSON.stringify(loans));
        renderMembers();
        renderExecutiveMembers();
        renderLoans();
        updateStats();
    }
}

