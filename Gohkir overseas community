// Open loan payment
function openLoanPayment(loanId) {
    const loan = loans.find(l => l.id === loanId);
    selectedLoanIndex = loans.indexOf(loan);
    document.getElementById('loanRemaining').value = loan.remaining;
    document.getElementById('loanPaymentAmount').value = '';
    
    // Set default date to today
    const today = new Date();
    const formattedDate = today.toISOString().split('T')[0];
    document.getElementById('loanPaymentDate').value = formattedDate;
    
    document.getElementById('loanPaymentMethod').value = 'Cash';
    document.getElementById('loanPaymentModal').classList.remove('hidden');
}

// Save loan payment
function saveLoanPayment() {
    if (selectedLoanIndex === null) return;
    const loan = loans[selectedLoanIndex];
    const paymentAmount = Number(document.getElementById('loanPaymentAmount').value);
    const paymentDate = document.getElementById('loanPaymentDate').value;
    const paymentMethod = document.getElementById('loanPaymentMethod').value;

    if (!paymentAmount || paymentAmount <= 0) {
        alert('Invalid payment amount');
        return;
    }

    if (paymentAmount > loan.remaining) {
        alert('Payment amount cannot exceed remaining loan');
        return;
    }

    // Add payment to loan
    loan.payments.push({
        amount: paymentAmount,
        date: paymentDate,
        method: paymentMethod
    });
    
    // Update remaining amount
    loan.remaining -= paymentAmount;
    
    localStorage.setItem('loans', JSON.stringify(loans));
    closeModal();
    renderLoans();
    updateStats();
}

// View loan payment history
function viewLoanPaymentHistory(loanId) {
    const loan = loans.find(l => l.id === loanId);
    if (!loan) return;
    
    let html = `<h4>Loan Details</h4>
                <p><strong>Amount:</strong> SR ${loan.amount}</p>
                <p><strong>Remaining:</strong> SR ${loan.remaining}</p>
                <p><strong>Date:</strong> ${loan.date}</p>
                <p><strong>Return Date:</strong> ${loan.returnDate}</p>
                <h4 style="margin-top: 20px;">Payment History</h4>`;
    
    if (loan.payments.length > 0) {
        html += `<table style="width: 100%; margin-top: 15px;">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount (SR)</th>
                            <th>Method</th>
                        </tr>
                    </thead>
                    <tbody>`;
        
        loan.payments.forEach(payment => {
            html += `<tr>
                        <td>${payment.date}</td>
                        <td>${payment.amount}</td>
                        <td>${payment.method}</td>
                    </tr>`;
        });
        
        html += `</tbody></table>`;
    } else {
        html += '<p>No payments recorded for this loan</p>';
    }
    
    document.getElementById('loanPaymentHistoryContent').innerHTML = html;
    document.getElementById('loanPaymentHistoryModal').classList.remove('hidden');
}

