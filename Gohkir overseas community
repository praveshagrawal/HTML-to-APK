    // Financial Information
    const memberLoans = loans.filter(loan => !loan.isDeleted && loan.remaining > 0 && loan.contact === loanMember.contact);
    const totalLoan = memberLoans.reduce((sum, loan) => sum + loan.remaining, 0);
    
    document.getElementById('loanMemberFinancialInfo').innerHTML = `
        <p><strong>Total Loans:</strong> SR ${totalLoan}</p>
        <p><strong>Active Loans:</strong> ${memberLoans.length}</p>
    `;
    
    // Loan History
    const loanHTML = memberLoans.map(loan => {
        const loanPayments = loan.payments.map(payment => `
            <div class="history-item">
                <div class="history-details">
                    <div>Loan Payment</div>
                    <div>${payment.method} • ${payment.date}</div>
                </div>
                <div class="history-amount paid-amount">- SR ${payment.amount}</div>
            </div>
        `).join('');
        
        return `
            <div class="card" style="margin-bottom: 20px;">
                <h4>Loan: SR ${loan.amount} (Remaining: SR ${loan.remaining})</h4>
                <p><strong>Date:</strong> ${loan.date}</p>
                <p><strong>Return Date:</strong> ${loan.returnDate}</p>
                <div style="margin-top: 15px;">
                    <h5>Payment History:</h5>
                    ${loanPayments || '<p>No payments recorded</p>'}
                </div>
            </div>
        `;
    }).join('');
    
    document.getElementById('loanMemberHistory').innerHTML = loanHTML 
        ? `<h3>Loan History (Total: SR ${totalLoan})</h3>${loanHTML}`
        : '<p class="text-center">No loans recorded</p>';
}

// Search members
function searchMembers() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const filtered = members.filter(m => 
        m.name.toLowerCase().includes(searchTerm) ||
        m.contact.includes(searchTerm) ||
