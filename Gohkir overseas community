<script>
const ADMIN_CONTACT = '03469066955';
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const EXECUTIVE_ROLES = [
    'President',
    'Vice President',
    'General Secretary',
    'Finance Secretary',
    'Press/Information Secretary',
    'Office/Coordination Secretary'
];

// Initialize data from localStorage or defaults
let members = JSON.parse(localStorage.getItem('members')) || [];
let executiveMembers = JSON.parse(localStorage.getItem('executiveMembers')) || {};
let loans = JSON.parse(localStorage.getItem('loans')) || [];
let loanMembers = JSON.parse(localStorage.getItem('loanMembers')) || [];
let selectedMemberIndex = null;
let selectedLoanIndex = null;

// Initialize membership numbers
members.forEach((member, index) => {
    if (!member.membershipNo) {
        member.membershipNo = `GOC-${String(index + 1).padStart(4, '0')}`;
    } else {
        member.membershipNo = `GOC-${member.membershipNo.split('-')[1]}`;
    }
    
    // Initialize payments if not present
    if (!member.payments) {
        member.payments = {};
    }
});

// Initialize loans with payment history if not present
loans.forEach(loan => {
    if (!loan.payments) {
        loan.payments = [];
    }
    if (typeof loan.remaining === 'undefined') {
        loan.remaining = loan.amount;
    }
});

// Save initialized data
localStorage.setItem('members', JSON.stringify(members));
localStorage.setItem('loans', JSON.stringify(loans));

// Set current date
document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-GB', {
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
});

// Helper function to calculate return date
function calculateReturnDate(date, days) {
    const loanDate = new Date(date);
    loanDate.setDate(loanDate.getDate() + parseInt(days));
    return loanDate.toLocaleDateString();
}

// Handle login function
function handleLogin() {
    const input = document.getElementById('loginInput').value.trim();
    if (input === ADMIN_CONTACT) {
        showAdminDashboard();
        return;
    }
    
    const member = members.find(m => m.contact === input || m.iqama === input || m.membershipNo === input);
    if (member) {
        showMemberDashboard(member);
        return;
    }
    
    const loanMember = loanMembers.find(m => m.contact === input);
    if (loanMember) {
        showLoanMemberDashboard(loanMember);
        return;
    }
    
    alert('Member not found. Please check credentials.');
}

// Show different sections
function showSection(sectionId) {
    // Hide all tab contents
    document.querySelectorAll('.tab-content').forEach(el => {
        el.classList.remove('active');
    });
    
    // Show the requested section
    document.getElementById(sectionId).classList.add('active');
    
    // Update tab states
    document.querySelectorAll('.tab').forEach(tab => {
        tab.classList.remove('active');
    });
    
    // Set the active tab
    document.querySelectorAll('.tab').forEach(tab => {
        if (tab.textContent.includes('Members List') && sectionId === 'membersSection') {
            tab.classList.add('active');
        } else if (tab.textContent.includes('Add Member') && sectionId === 'memberForm') {
            tab.classList.add('active');
        } else if (tab.textContent.includes('Executive Body') && sectionId === 'executiveSection') {
            tab.classList.add('active');
        } else if (tab.textContent.includes('Members Loans') && sectionId === 'loanSection') {
            tab.classList.add('active');
        } else if (tab.textContent.includes('Statistics') && sectionId === 'statsSection') {
            tab.classList.add('active');
        }
    });
    
    // Special handling for stats section
    if (sectionId === 'statsSection') {
        renderCharts();
    }
}

// Show login sections
function showLoginSection(sectionId) {
    const sections = ['loginFormSection', 'executiveBodyLoginSection', 'loansLoginSection'];
    sections.forEach(id => {
        document.getElementById(id).classList.add('hidden');
    });
    document.getElementById(sectionId).classList.remove('hidden');
}

// Toggle member fields based on selection
function toggleMemberFields() {
    const memberType = document.getElementById('memberType').value;
    document.getElementById('newMemberFields').classList.toggle('hidden', memberType !== 'new');
    document.getElementById('existingMemberFields').classList.toggle('hidden', memberType !== 'existing');
}

// Toggle loan member fields
function toggleLoanMemberFields() {
    const memberType = document.getElementById('loanMemberType').value;
    document.getElementById('existingLoanMemberFields').classList.toggle('hidden', memberType !== 'existing');
    document.getElementById('newLoanMemberFields').classList.toggle('hidden', memberType !== 'new');
}

// Get members with loans
function getMembersWithLoans() {
    const loanContacts = new Set(loans.filter(loan => loan.isExistingMember && !loan.isDeleted && loan.remaining > 0).map(loan => loan.contact));
    return members.filter(member => loanContacts.has(member.contact));
}

// Save member function
function saveMember() {
    const memberType = document.getElementById('memberType').value;
    let newMember;

    if (memberType === 'existing') {
        const name = document.getElementById('existingMemberName').value.trim();
        const contact = document.getElementById('existingMemberContact').value.trim();
        if (!name || !contact) {
            alert('Please select an existing member');
            return;
        }
        const existingMember = members.find(m => m.name === name && m.contact === contact);
        if (!existingMember) {
            alert('Selected member not found');
            return;
        }
        showSection('membersSection');
        renderMembers();
        updateStats();
        return;
    } else {
        newMember = {
            id: Date.now(),
            membershipNo: `GOC-${String(members.length + 1).padStart(4, '0')}`,
            name: document.getElementById('newName').value.trim(),
            fatherName: document.getElementById('newFatherName').value.trim(),
            contact: document.getElementById('newContact').value.trim(),
            iqama: document.getElementById('newIqama').value.trim(),
            overseasAddress: document.getElementById('newOverseasAddress').value.trim(),
            pakistanAddress: document.getElementById('newPakistanAddress').value.trim(),
            payments: {},
            total: 0,
            nextPaymentMonth: MONTHS[0],
            lastPayment: null
        };

        if (!newMember.name || !newMember.fatherName || !newMember.contact || !newMember.iqama) {
            alert('Please fill all required fields');
            return;
        }

        if (members.some(m => m.contact === newMember.contact || m.iqama === newMember.iqama || m.membershipNo === newMember.membershipNo)) {
            alert('Member already exists');
            return;
        }

        members.push(newMember);
        localStorage.setItem('members', JSON.stringify(members));
    }

    showSection('membersSection');
    renderMembers();
    updateStats();
}

// Open payment modal
function openPayments(index) {
    selectedMemberIndex = index;
    const member = members[index];
    const currentYear = new Date().getFullYear();
    document.getElementById('paymentMonth').value = `${member.nextPaymentMonth} ${currentYear}`;
    document.getElementById('paymentAmount').value = 100;
    document.getElementById('paymentMethod').value = 'Cash';
    document.getElementById('paymentModal').classList.remove('hidden');
}

// Save payment
function savePayment() {
    if (selectedMemberIndex === null) return;
    const member = members[selectedMemberIndex];
    const amount = Number(document.getElementById('paymentAmount').value);
    const method = document.getElementById('paymentMethod').value;
    
    if (!amount || amount <= 0) {
        alert('Invalid amount');
        return;
    }

    const month = member.nextPaymentMonth;
    member.payments[month] = {
        amount: amount,
        method: method,
        date: new Date().toLocaleDateString()
    };
    member.total += amount;
    member.lastPayment = new Date().toLocaleDateString();
    
    const nextMonthIndex = (MONTHS.indexOf(month) + 1) % 12;
    member.nextPaymentMonth = MONTHS[nextMonthIndex];
    
    localStorage.setItem('members', JSON.stringify(members));
    closeModal();
    renderMembers();
    updateStats();
}

// Open payment edits
function openPaymentEdits(index) {
    selectedMemberIndex = index;
    const member = members[index];
    const paymentHTML = MONTHS.map(month => `
        <div class="form-group">
            <label>${month}</label>
            <input type="number" data-month="${month}" value="${member.payments[month]?.amount || 0}" min="0">
            <select data-month="${month}">
                <option value="Cash" ${member.payments[month]?.method === 'Cash' ? 'selected' : ''}>Cash</option>
                <option value="Bank" ${member.payments[month]?.method === 'Bank' ? 'selected' : ''}>Bank</option>
            </select>
        </div>
    `).join('');
    document.getElementById('paymentEditFields').innerHTML = paymentHTML;
    document.getElementById('paymentEditModal').classList.remove('hidden');
}

// Save payment edits
function savePaymentEdits() {
    if (selectedMemberIndex === null) return;
    const member = members[selectedMemberIndex];
    let newTotal = 0;
    let lastPaidIndex = -1;

    MONTHS.forEach(month => {
        const amount = Number(document.querySelector(`input[data-month="${month}"]`).value) || 0;
        const method = document.querySelector(`select[data-month="${month}"]`).value;
        
        member.payments[month] = {
            amount: amount,
            method: method,
            date: member.payments[month]?.date || new Date().toLocaleDateString()
        };
        
        newTotal += amount;
        if (amount > 0) {
            const idx = MONTHS.indexOf(month);
            if (idx > lastPaidIndex) lastPaidIndex = idx;
        }
    });

    member.total = newTotal;
    member.nextPaymentMonth = MONTHS[(lastPaidIndex + 1) % 12];
    member.lastPayment = lastPaidIndex >= 0 ? new Date().toLocaleDateString() : null;
    
    localStorage.setItem('members', JSON.stringify(members));
    closeModal();
    renderMembers();
    updateStats();
}

// Create backup
function createBackup() {
    const backup = {
        date: new Date().toISOString(),
        members: members,
        executiveMembers: executiveMembers,
        loans: loans,
        loanMembers: loanMembers
    };
    const blob = new Blob([JSON.stringify(backup)], {type: "application/json"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `gohkir_backup_${Date.now()}.json`;
    a.click();
    URL.revokeObjectURL(url);
}

// Restore backup
function restoreBackup(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const backup = JSON.parse(e.target.result);
            if (!backup.members) throw new Error('Invalid backup file');
            
            backup.members.forEach((member, index) => {
                if (!member.membershipNo) {
                    member.membershipNo = `GOC-${String(index + 1).padStart(4, '0')}`;
                } else {
                    member.membershipNo = `GOC-${member.membershipNo.split('-')[1]}`;
                }
            });

            if (confirm('This will overwrite current data. Continue?')) {
                members = backup.members;
                executiveMembers = backup.executiveMembers || {};
                loans = backup.loans || [];
                loanMembers = backup.loanMembers || [];
                localStorage.setItem('members', JSON.stringify(members));
                localStorage.setItem('executiveMembers', JSON.stringify(executiveMembers));
                localStorage.setItem('loans', JSON.stringify(loans));
                localStorage.setItem('loanMembers', JSON.stringify(loanMembers));
                renderMembers();
                renderExecutiveMembers();
                renderLoans();
                updateStats();
                alert('Backup restored successfully');
            }
        } catch (error) {
            alert('Error restoring backup: ' + error.message);
        }
    };
    reader.readAsText(file);
}

// Export to Excel
function exportToExcel() {
    const data = members.map(m => ({
        "Membership No": m.membershipNo,
        Name: m.name,
        "Father's Name": m.fatherName,
        Contact: m.contact,
        Iqama: m.iqama,
        "Overseas Address": m.overseasAddress,
        "Pakistan Address": m.pakistanAddress,
        ...Object.fromEntries(MONTHS.map(month => [month, m.payments[month]?.amount || 0])),
        ...Object.fromEntries(MONTHS.map(month => [`${month}-method`, m.payments[month]?.method || ''])),
        Total: m.total,
        "Last Payment": m.lastPayment,
        "Next Payment": m.nextPaymentMonth
    }));
    
    const ws = XLSX.utils.json_to_sheet(data);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Members");
    XLSX.writeFile(wb, "members.xlsx");
}

// Handle Excel upload
function handleExcelUpload(event) {
    const file = event.target.files[0];
    const reader = new FileReader();
    reader.onload = function(e) {
        const data = new Uint8Array(e.target.result);
        const wb = XLSX.read(data, {type: "array"});
        const json = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]]);
        
        members = json.map((item, index) => ({
            id: item.id || Date.now(),
            membershipNo: item["Membership No"] || `GOC-${String(index + 1).padStart(4, '0')}`,
            name: item.Name,
            fatherName: item["Father's Name"] || '',
            contact: item.Contact,
            iqama: item.Iqama,
            overseasAddress: item["Overseas Address"] || '',
            pakistanAddress: item["Pakistan Address"] || '',
            payments: Object.fromEntries(MONTHS.map(m => [m, {
                amount: item[m] || 0,
                method: item[`${m}-method`] || 'Cash',
                date: item[`${m}-date`] || new Date().toLocaleDateString()
            }])),
            total: item.Total || 0,
            nextPaymentMonth: item["Next Payment"] || MONTHS[0],
            lastPayment: item["Last Payment"] || null
        }));
        
        localStorage.setItem('members', JSON.stringify(members));
        renderMembers();
        renderExecutiveMembers();
        renderLoans();
        updateStats();
    };
    reader.readAsArrayBuffer(file);
}

// Render members
function renderMembers(memberList = members) {
    const tbody = document.getElementById('membersBody');
