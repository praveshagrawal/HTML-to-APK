// Render member dropdown
function renderMemberDropdown(role, assignedMembers) {
    return members
        .filter(m => !assignedMembers.has(m.contact) || executiveMembers[role]?.contact === m.contact)
        .map(m => `<div onclick="selectMember('${role}', '${m.name}', '${m.contact}')">${m.name} (${m.membershipNo})</div>`)
        .join('');
}

// Show member dropdown
function showMemberDropdown(input, type) {
    let dropdown, role;
    if (type === 'executive') {
        role = input.getAttribute('data-role');
        dropdown = document.getElementById(`dropdown-${role.replace(/\//g, '-')}`);
    } else if (type === 'member') {
        dropdown = document.getElementById('memberDropdown');
    } else {
        dropdown = document.getElementById('loanMemberDropdown');
    }
    const searchTerm = input.value.toLowerCase();
    
    document.querySelectorAll('.member-dropdown-list').forEach(d => {
        if (d !== dropdown) d.style.display = 'none';
    });

    dropdown.style.display = 'block';
    let filteredMembers;
    if (type === 'executive') {
        const assignedMembers = new Set(Object.values(executiveMembers).map(m => m?.contact));
        filteredMembers = members.filter(m => 
            (!assignedMembers.has(m.contact) || executiveMembers[role]?.contact === m.contact) &&
            (m.name.toLowerCase().includes(searchTerm) || m.membershipNo.toLowerCase().includes(searchTerm))
        );
        dropdown.innerHTML = filteredMembers
            .map(m => `<div onclick="selectMember('${role}', '${m.name}', '${m.contact}')">${m.name} (${m.membershipNo})</div>`)
            .join('');
    } else if (type === 'member') {
        filteredMembers = getMembersWithLoans().filter(m => 
            m.name.toLowerCase().includes(searchTerm) || m.membershipNo.toLowerCase().includes(searchTerm)
        );
        dropdown.innerHTML = filteredMembers
            .map(m => `<div onclick="selectExistingMember('${m.name}', '${m.contact}')">${m.name} (${m.membershipNo})</div>`)
            .join('');
    } else {
        filteredMembers = members.filter(m => 
            m.name.toLowerCase().includes(searchTerm) || m.membershipNo.toLowerCase().includes(searchTerm)
        );
        dropdown.innerHTML = filteredMembers
            .map(m => `<div onclick="selectLoanMember('${m.name}', '${m.contact}')">${m.name} (${m.membershipNo})</div>`)
            .join('');
    }

    if (!filteredMembers.length) dropdown.style.display = 'none';
}

