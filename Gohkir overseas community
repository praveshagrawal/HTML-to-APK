// Save loan
function saveLoan() {
    const memberType = document.getElementById('loanMemberType').value;
    let name, contact;

    if (memberType === 'existing') {
        name = document.getElementById('loanMemberName').value.trim();
        contact = document.getElementById('loanMemberContact').value.trim();
        if (!name || !contact) {
            alert('Please select a member');
            return;
        }
        const existingMember = members.find(m => m.name === name && m.contact === contact);
        if (!existingMember) {
            alert('Selected member not found');
            return;
        }
    } else {
        name = document.getElementById('loanNewName').value.trim();
        contact = document.getElementById('loanNewContact').value.trim();
        if (!name || !contact) {
            alert('Please fill all required fields');
            return;
        }
        if (loanMembers.some(m => m.contact === contact) || members.some(m => m.contact === contact)) {
            alert('Contact number already exists');
            return;
        }
        loanMembers.push({ name, contact });
        localStorage.setItem('loanMembers', JSON.stringify(loanMembers));
    }

    const amount = Number(document.getElementById('loanAmount').value);
    const period = parseInt(document.getElementById('loanPeriod').value, 10);
    if (isNaN(period) || period < 1 || period > 120) {
        alert('Please enter a valid loan period between 1 and 120 days');
        return;
    }
    const date = new Date().toLocaleDateString();
    const returnDate = calculateReturnDate(date, period);
    const totalContributions = members.reduce((sum, m) => sum + m.total, 0);
    const totalLoans = loans.reduce((sum, loan) => sum + (loan.remaining || 0), 0);

    if (!amount || amount <= 0) {
        alert('Invalid loan amount');
        return;
    }

    if (amount > (totalContributions - totalLoans)) {
        alert('Loan amount exceeds available cash in hand');
        return;
    }

    const newLoan = {
        id: Date.now(),
        name,
        contact,
        amount,
        remaining: amount,
        period: period,
        date,
        returnDate,
        payments: [],
        isExistingMember: memberType === 'existing',
        isDeleted: false
    };

    loans.push(newLoan);
    localStorage.setItem('loans', JSON.stringify(loans));
    toggleLoanForm();
    renderLoans();
    updateStats();
}

