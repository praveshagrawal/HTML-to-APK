// Show member dashboard
function showMemberDashboard(member) {
    document.getElementById('authSection').classList.add('hidden');
    document.getElementById('adminDashboard').classList.add('hidden');
    document.getElementById('memberDashboard').classList.remove('hidden');
    document.getElementById('loanMemberDashboard').classList.add('hidden');
    
    // Personal Information
    document.getElementById('memberPersonalInfo').innerHTML = `
        <p><strong>Membership Number:</strong> ${member.membershipNo}</p>
        <p><strong>Name:</strong> ${member.name}</p>
        <p><strong>Father's Name:</strong> ${member.fatherName}</p>
        <p><strong>Contact:</strong> ${member.contact}</p>
        <p><strong>Iqama:</strong> ${member.iqama}</p>
        <p><strong>Overseas Address:</strong> ${member.overseasAddress}</p>
        <p><strong>Pakistan Address:</strong> ${member.pakistanAddress}</p>
    `;
    
    // Financial Information
    document.getElementById('memberFinancialInfo').innerHTML = `
        <p><strong>Total Contributions:</strong> SR ${member.total}</p>
        <p><strong>Next Payment Due:</strong> ${member.nextPaymentMonth}</p>
    `;
    
    // Payment History
    const payments = Object.entries(member.payments)
        .filter(([_, data]) => data.amount > 0)
        .sort((a, b) => MONTHS.indexOf(a[0]) - MONTHS.indexOf(b[0]))
        .map(([m, data]) => `
            <div class="history-item">
                <div class="history-details">
                    <div><strong>${m}</strong> Contribution</div>
                    <div>${data.method} • ${data.date}</div>
                </div>
                <div class="history-amount paid-amount">+ SR ${data.amount}</div>
            </div>
        `).join('');
    
    document.getElementById('paymentHistory').innerHTML = payments 
        ? `<h3>Payment History</h3>${payments}`
        : '<p class="text-center">No payments recorded</p>';

    // Loan History
    const memberLoans = loans.filter(loan => !loan.isDeleted && loan.remaining > 0 && loan.contact === member.contact);
    const totalLoan = memberLoans.reduce((sum, loan) => sum + loan.remaining, 0);
    
    const loanHTML = memberLoans.map(loan => {
        const loanPayments = loan.payments.map(payment => `
            <div class="history-item">
                <div class="history-details">
                    <div>Loan Payment</div>
                    <div>${payment.method} • ${payment.date}</div>
                </div>
                <div class="history-amount paid-amount">- SR ${payment.amount}</div>
            </div>
        `).join('');
        
        return `
            <div class="card" style="margin-bottom: 20px;">
                <h4>Loan: SR ${loan.amount} (Remaining: SR ${loan.remaining})</h4>
                <p><strong>Date:</strong> ${loan.date}</p>
                <p><strong>Return Date:</strong> ${loan.returnDate}</p>
                <div style="margin-top: 15px;">
                    <h5>Payment History:</h5>
                    ${loanPayments || '<p>No payments recorded</p>'}
                </div>
            </div>
        `;
    }).join('');
    
    document.getElementById('loanHistory').innerHTML = loanHTML 
        ? `<h3>Loan History (Total: SR ${totalLoan})</h3>${loanHTML}`
        : '<p class="text-center">No loans recorded</p>';
}

// Show loan member dashboard
function showLoanMemberDashboard(loanMember) {
    document.getElementById('authSection').classList.add('hidden');
    document.getElementById('adminDashboard').classList.add('hidden');
    document.getElementById('memberDashboard').classList.add('hidden');
    document.getElementById('loanMemberDashboard').classList.remove('hidden');
    
