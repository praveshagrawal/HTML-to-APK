    <script>
        const { FFmpeg } = FFmpegWASM;
        const ffmpeg = new FFmpeg();
        let currentVideoFile = null;
        let videoDuration = 0;
        let currentActiveEffect = 'none';
        let generatedAIImageBlob = null; // Store generated AI image blob

        const preview = document.getElementById('preview');
        const fileInput = document.getElementById('fileInput');
        const playPauseBtn = document.getElementById('playPauseBtn');
        const mainTimeline = document.getElementById('mainTimeline');
        const exportProgressBar = document.getElementById('exportProgressBar');
        const exportProgressText = document.getElementById('exportProgressText');
        const funnyClipOverlay = document.getElementById('funnyClipOverlay');
        const funnyClipImg = document.getElementById('funnyClipImg');
        const generatedImage = document.getElementById('generatedImage');
        const aiPlaceholder = document.getElementById('aiPlaceholder');

        // FFmpeg Initialization
        const loadFFmpeg = async () => {
            if (!ffmpeg.loaded) {
                console.log('FFmpeg loading...');
                try {
                    await ffmpeg.load({
                        coreURL: 'https://unpkg.com/@ffmpeg/core@0.12.6/dist/umd/ffmpeg-core.js',
                        wasmURL: 'https://unpkg.com/@ffmpeg/core@0.12.6/dist/umd/ffmpeg-core.wasm'
                    });
                    console.log('FFmpeg loaded!');
                    // Optionally enable buttons here after loading
                } catch (error) {
                    console.error('Failed to load FFmpeg:', error);
                    alert('वीडियो प्रोसेसिंग के लिए FFmpeg लोड करने में त्रुटि। कृपया बाद में पुनः प्रयास करें।');
                }
            }
        };

        ffmpeg.on('log', ({ message }) => console.log(message));
        ffmpeg.on('progress', ({ progress, time }) => {
            const percentage = Math.round(progress * 100);
            exportProgressBar.style.width = `${percentage}%`;
            exportProgressText.textContent = `एक्सपोर्ट हो रहा है: ${percentage}%...`;
        });

        // Screen Navigation
        function showScreen(screenId, navItem = null) {
            document.querySelectorAll('.home-screen, .editor-screen, .effects-panel, .ai-image-panel, .text-sticker-panel, .share-export-panel').forEach(screen => {
                screen.style.display = 'none';
            });
            document.getElementById(screenId).style.display = 'flex';

            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            if (navItem) {
                navItem.classList.add('active');
            } else {
                // If called without navItem (e.g., from 'Create New Project'), activate the editor nav item
                document.querySelector(`.nav-item[data-screen="${screenId}"]`).classList.add('active');
            }
        }

        // --- File Upload & Preview ---
        fileInput.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (file) {
                currentVideoFile = file;
                const fileURL = URL.createObjectURL(file);
                preview.src = fileURL;
                preview.load();
                preview.onloadedmetadata = () => {
                    videoDuration = preview.duration;
                    addClipToTimeline(fileURL, 'video', videoDuration);
                    playPauseBtn.textContent = '⏸️ रोकें';
                    preview.play();
                };
            }
        });

        // Add clip to (simplified) timeline
        function addClipToTimeline(src, type, duration) {
            const clip = document.createElement('div');
            clip.className = 'clip-item';
            clip.dataset.type = type;
            clip.dataset.src = src;
            clip.style.width = `${duration * 10}px`; // Example: 10px per second
            
            if (type === 'video') {
                const videoThumb = document.createElement('video');
                videoThumb.src = src;
                videoThumb.currentTime = 1; // Show a frame
                videoThumb.muted = true;
                videoThumb.preload = 'metadata';
                videoThumb.onloadeddata = () => {
                    const canvas = document.createElement('canvas');
                    canvas.width = videoThumb.videoWidth;
                    canvas.height = videoThumb.videoHeight;
                    canvas.getContext('2d').drawImage(videoThumb, 0, 0, canvas.width, canvas.height);
                    const img = document.createElement('img');
                    img.src = canvas.toDataURL();
                    clip.appendChild(img);
                };
            } else if (type === 'image' || type === 'sticker' || type === 'ai-image') {
                const img = document.createElement('img');
                img.src = src;
                clip.appendChild(img);
            } else if (type === 'text') {
                const p = document.createElement('p');
                p.textContent = src; // text content directly
                p.style.fontSize = '0.8em';
                p.style.whiteSpace = 'normal';
                clip.appendChild(p);
            }
            mainTimeline.appendChild(clip);
            mainTimeline.scrollLeft = mainTimeline.scrollWidth; // Scroll to end
        }

        // --- Video Player Controls ---
        playPauseBtn.addEventListener('click', () => {
            if (preview.paused) {
                preview.play();
                playPauseBtn.textContent = '⏸️ रोकें';
            } else {
                preview.pause();
                playPauseBtn.textContent = '▶️ चलाएँ';
            }
        });

        preview.addEventListener('ended', () => {
            playPauseBtn.textContent = '▶️ चलाएँ';
        });

        // Simplified editing functions (for UI demo, actual logic would be complex)
        function splitClip() { alert('क्लिप स्प्लिट कार्यक्षमता (FFmpeg आवश्यक)'); }
        function trimClip() { alert('क्लिप ट्रिम कार्यक्षमता (FFmpeg आवश्यक)'); }
        function changeSpeed() { alert('स्पीड बदलने की कार्यक्षमता (FFmpeg आवश्यक)'); }
        function addAudio() { alert('ऑडियो जोड़ने की कार्यक्षमता (UI/FFmpeg)'); }
        function addLayer() { alert('नई लेयर जोड़ने की कार्यक्षमता (UI/FFmpeg)'); }

        // --- VFX Effects ---
        function applyVFX(effect) {
            document.querySelectorAll('.effect-card').forEach(card => card.classList.remove('active'));
            document.querySelector(`.effect-card[data-effect="${effect}"]`).classList.add('active');
            currentActiveEffect = effect;

            // Simplified client-side visual effect for preview
            if (effect === 'blur') {
                preview.style.filter = 'blur(5px)';
            } else if (effect === 'vintage') {
                preview.style.filter = 'sepia(0.8) saturate(1.5)';
            } else if (effect === 'neon') {
                preview.style.filter = 'contrast(2) brightness(1.2) hue-rotate(180deg)';
            } else if (effect === 'glitch') {
                 // For actual glitch, you'd need a canvas and shader
                 preview.style.filter = 'grayscale(0.5) contrast(1.5)';
            } else {
                preview.style.filter = 'none';
            }
            alert(`प्रभाव लागू किया गया: ${effect}`);
        }

        function addOnlineClip(src) {
            funnyClipImg.src = src;
            funnyClipOverlay.style.display = 'block';
            addClipToTimeline(src, 'sticker', 5); // Add as a sticker for 5 seconds
        }

        // --- AI Image Generation ---
        let currentAIStyle = 'photorealistic';
        let currentAIRatio = '1:1';

        document.querySelectorAll('.ai-option-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const group = btn.dataset.style ? 'style' : 'ratio';
                document.querySelectorAll(`.ai-option-btn[data-${group}]`).forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                if (group === 'style') {
                    currentAIStyle = btn.dataset.style;
                } else {
                    currentAIRatio = btn.dataset.ratio;
                }
            });
        });

        async function generateAIImage() {
            const prompt = document.getElementById('aiPrompt').value;
            if (!prompt) {
                alert('कृपया AI इमेज जेनरेट करने के लिए एक प्रोम्प्ट दर्ज करें।');
                return;
            }
            
            aiPlaceholder.textContent = 'इमेज जेनरेट हो रही है...';
            generatedImage.style.display = 'none';
            // Simulate AI image generation
            const dummyImageUrl = `https://via.placeholder.com/400x${currentAIRatio === '16:9' ? '225' : currentAIRatio === '9:16' ? '711' : '400'}/${currentAIStyle === 'photorealistic' ? 'ff00ff' : currentAIStyle === 'anime' ? '00ffff' : currentAIStyle === 'painting' ? 'ffff00' : '00ff00'}/ffffff?text=${prompt.substring(0,20).replace(/ /g, '+')}`;
            
            // In a real app, you'd make an API call to an AI service here
            // const response = await fetch('/api/generate-image', { method: 'POST', body: JSON.stringify({ prompt, style: currentAIStyle, ratio: currentAIRatio }) });
            // const data = await response.json();
            // generatedAIImageBlob = data.imageUrl; // Store actual blob or URL

            // For demo: directly use placeholder
            generatedAIImageBlob = dummyImageUrl;
            generatedImage.src = generatedAIImageBlob;
            generatedImage.style.display = 'block';
            aiPlaceholder.textContent = '';
        }

        function addGeneratedImageToTimeline() {
            if (generatedAIImageBlob) {
                addClipToTimeline(generatedAIImageBlob, 'ai-image', 5); // Add as a 5-second image
                alert('AI जेनरेटेड इमेज टाइमलाइन में जोड़ी गई।');
            } else {
                alert('कृपया पहले एक AI इमेज जेनरेट करें।');
            }
        }

        // --- Text & Sticker ---
        let currentFont = 'sans-serif';
        let currentTextColor = 'white';

        document.querySelectorAll('.font-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.font-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentFont = btn.dataset.font;
            });
        });

        document.querySelectorAll('.color-swatch').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.color-swatch').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentTextColor = btn.dataset.color;
            });
        });

        function addTextOverlay() {
            const text = document.getElementById('textOverlayInput').value;
            if (text) {
                // In a real app, you'd add this to the video preview with its style
                addClipToTimeline(text, 'text', 5);
                alert(`टेक्स्ट जोड़ा गया: "${text}" (फ़ॉन्ट: ${currentFont}, रंग: ${currentTextColor})`);
            } else {
                alert('कृपया जोड़ने के लिए कुछ टेक्स्ट दर्ज करें।');
            }
        }

        function addSticker(src) {
            // In a real app, you'd add this as an overlay on the video preview
            addClipToTimeline(src, 'sticker', 5);
            alert('स्टिकर टाइमलाइन में जोड़ा गया।');
        }

        // --- Export & Share ---
        async function exportVideo() {
            if (!currentVideoFile || !ffmpeg.loaded) {
                alert('कृपया पहले एक वीडियो अपलोड करें और सुनिश्चित करें कि FFmpeg लोड हो गया है।');
                return;
            }

            const resolution = document.getElementById('resolutionSelect').value;
            const fps = document.getElementById('fpsSelect').value;
            const format = document.getElementById('formatSelect').value;

            exportProgressText.textContent = 'एक्सपोर्ट शुरू हो रहा है...';
            exportProgressBar.style.width = '0%';

            try {
                // Write the input video file to FFmpeg's virtual file system
                ffmpeg.FS('writeFile', 'input.mp4', await FFmpegWASM.fetchFile(currentVideoFile));

                // Construct FFmpeg command based on effects, resolution, fps, etc.
                let vf_filter = '';
                if (currentActiveEffect === 'blur') vf_filter = 'boxblur=5';
                else if (currentActiveEffect === 'glitch') vf_filter = 'split[a],fifo,[a]fifo,overlay'; // Simple glitch
                else if (currentActiveEffect === 'vintage') vf_filter = 'colorlevels=rimin=0.039:gimin=0.039:bimin=0.039:rimax=0.961:gimax=0.961:bimax=0.961,curves=all=\'0/0.15 0.5/0.7 1/1\''; // Example vintage
                else if (currentActiveEffect === 'neon') vf_filter = 'colorchannelmixer=.3:.4:.3:0:.3:.4:.3:0:.3:.4:.3:0'; // Simplified neon

                const resolutionMap = {
                    '720p': '1280x720',
                    '1080p': '1920x1080',
                    '4K': '3840x2160'
                };
                const outputResolution = resolutionMap[resolution];

                const ffmpeg_args = [
                    '-i', 'input.mp4',
                    '-vf', vf_filter ? `${vf_filter},scale=${outputResolution}` : `scale=${outputResolution}`,
                    '-r', fps, // Set frame rate
                    '-preset', 'fast', // Faster export
                    '-c:v', 'libx264',
                    '-crf', '28', // Compression quality (lower is better quality, larger file)
                    '-movflags', 'faststart',
                    `output.${format}`
                ];

                await ffmpeg.exec(ffmpeg_args);

                // Read the output file from FFmpeg's virtual file system
                const data = await ffmpeg.FS('readFile', `output.${format}`);
                const blob = new Blob([data.buffer], { type: `video/${format}` });
                const url = URL.createObjectURL(blob);

                // Create a download link
                const a = document.createElement('a');
                a.href = url;
                a.download = `exported_video.${format}`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);

                exportProgressText.textContent = 'एक्सपोर्ट पूरा हुआ! 🎉';
            } catch (error) {
                console.error('वीडियो एक्सपोर्ट करने में त्रुटि:', error);
                exportProgressText.textContent = 'एक्सपोर्ट विफल रहा। 😔';
                alert('वीडियो एक्सपोर्ट करने में त्रुटि आई। कंसोल देखें।');
            } finally {
                // Clean up FFmpeg's file system (optional)
                ffmpeg.FS('unlink', 'input.mp4').catch(e => console.warn("Failed to unlink input.mp4", e));
                ffmpeg.FS('unlink', `output.${format}`).catch(e => console.warn("Failed to unlink output file", e));
            }
        }

        function shareTo(platform) {
            alert(`वीडियो ${platform} पर साझा करने के लिए तैयार है! (यह एक डेमो है, वास्तविक साझाकरण कार्यक्षमता के लिए API एकीकरण की आवश्यकता होगी)`);
            // In a real app, you would use Web Share API or platform-specific SDKs
        }

        // Initialize with Home Screen
        showScreen('homeScreen');
    </script>
